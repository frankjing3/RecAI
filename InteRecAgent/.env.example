# Copy this file to .env and fill in the secret values.
# Existing operating-system variables take precedence over values in this file.

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_TYPE=open_ai
OPENAI_API_VERSION=

AGENT_ENGINE=gpt-4-0613
OPENAI_ENGINE=gpt-4-0613
OPENAI_ENGINE_TYPE=chat

# python-dotenv expands ${NAME} references when the file is loaded.
SIMULATOR_API_KEY=${OPENAI_API_KEY}
SIMULATOR_API_BASE=${OPENAI_API_BASE}
SIMULATOR_API_TYPE=${OPENAI_API_TYPE}
SIMULATOR_API_VERSION=${OPENAI_API_VERSION}
SIMULATOR_ENGINE=${OPENAI_ENGINE}
SIMULATOR_ENGINE_TYPE=chat_completion

DOMAIN=game
TOKENIZERS_PARALLELISM=false
PYTHONPATH=.

# Optional: set to 1 for verbose ranking-evaluation output.
DEBUG=0
